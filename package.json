{
  "name": "dsh-bundle-antigravity-host",
  "version": "0.1.56",
  "description": "Google Antigravity ACP, AI Studio, Vertex AI, and optional Colab tools for DeepSeek Harness.",
  "displayName": "Antigravity ACP",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "antigravity",
    "acp",
    "agent-client-protocol",
    "gemini",
    "vertex-ai",
    "google-colab",
    "model-provider"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-antigravity-acp.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-antigravity-acp#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-antigravity-acp/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./proxy": "./dist/proxy/index.js",
    "./aistudio": "./dist/aistudio/index.js",
    "./vertex": "./dist/vertex/index.js",
    "./colab": "./dist/colab/index.js",
    "./colab/locale/*.json": "./locale/colab/*.json"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "locale/colab/*.json",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.5 <0.2.3-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.5 <0.2.3-0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@cortexkit/antigravity-auth-core": "3.0.14",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "undici": "8.12.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@types/node": "^22.19.0",
    "@types/react-test-renderer": "18.3.1",
    "@types/yauzl": "^2.10.3",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "license": "MIT"
}
